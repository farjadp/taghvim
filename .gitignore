node_modules/
.next/
out/
.env*
!.env.example
*.tsbuildinfo
playwright-report/
test-results/
.DS_Store
# Claude Code: personal settings and work files stay local; the shared agent
# team (agents, skills, hooks, templates, settings.json) is committed.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/hooks/
!.claude/templates/
!.claude/settings.json

# Next.js regenerates this on every dev/build; it flipped between
# .next/dev/types and .next/types and kept showing up as drift.
next-env.d.ts

# Extension build output (npm run build:extension[:firefox])
extension/dist/
extension/dist-firefox/
extension/*.zip

# Swift package build output (swift test in mobile/ios/TaghvimCore)
mobile/ios/**/.build/
mobile/ios/**/.swiftpm/

# Gradle build output (./gradlew test in mobile/android/core)
mobile/android/**/build/
mobile/android/**/.gradle/
mobile/android/**/.kotlin/

# The app's web bundle (npm run build:app); Capacitor copies it into the native project
mobile/web/
