<?xml version="1.0" encoding="utf-8"?>
<!--
  Source: mobile/android/app/app/src/main/res/xml/data_extraction_rules.xml
  Version: 0.2.0 — 2026-11-20
  Why: Keeps the app's data out of device-to-device transfer on Android 12+,
       which ignores allowBackup="false". The list of personal dates lives in
       the WebView's localStorage beside the settings, in one LevelDB, so the
       two cannot be separated: everything stays on this phone. All nine
       domains are excluded: the five original ones plus the device_* domains
       (the device-protected storage used before first unlock). The
       <cloud-backup> block repeats the same list as belt-and-braces:
       allowBackup="false" already turns cloud backup off, and this keeps it
       off should that attribute ever change.
  Env / Deps: Named by android:dataExtractionRules in AndroidManifest.xml;
       src/lib/android-manifest.test.ts fails if either block loses a domain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
