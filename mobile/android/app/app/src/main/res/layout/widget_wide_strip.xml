<?xml version="1.0" encoding="utf-8"?>
<!-- Source: res/layout/widget_wide_strip.xml — wide B, strip form (4×1 landscape, 554×51dp): a narrower block with the numeral only, then «weekday month year» and the occasion on one row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/block"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_block_clay"
        android:gravity="center">

        <TextView
            android:id="@+id/day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="۱"
            android:textColor="@color/widget_paper"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="یکشنبه فروردین ۱۴۰۶"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/occasion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="نوروز"
            android:textColor="@color/widget_clay"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
