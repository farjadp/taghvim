{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(node scripts/sign-release-apk.mjs:*)",
      "Bash(node scripts/sign-release-aab.mjs:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/taghvim-keys/**)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
