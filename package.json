{
  "name": "taghvim",
  "version": "0.9.36",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "sync:javidnaman": "node scripts/sync-javidnaman.mjs",
    "check:live": "node scripts/check-live.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:og": "node scripts/build-og.mjs",
    "build:widget-data": "node scripts/build-widget-data.mjs",
    "build:extension": "vite build --config extension/vite.config.ts && node scripts/check-extension.mjs extension/dist",
    "build:extension:firefox": "TARGET=firefox vite build --config extension/vite.config.ts && node scripts/check-extension.mjs extension/dist-firefox",
    "package:extension": "node scripts/package-extension.mjs",
    "build:app": "TARGET=app vite build --config extension/vite.config.ts && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/share": "8.0.1",
    "@fontsource/vazirmatn": "5.3.0",
    "adhan": "4.4.4",
    "jalaali-js": "2.0.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sahel-font": "^3.4.0",
    "shabnam-font": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
